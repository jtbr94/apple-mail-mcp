# Stripe secret key (test key starts with sk_test_, live with sk_live_)
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhook endpoint (whsec_...), from the Stripe dashboard or `stripe listen`
STRIPE_WEBHOOK_SECRET=
# Public origin used in success/cancel URLs, e.g. https://www.sahkocoffee.com (optional; inferred from the request when unset)
SITE_URL=
# Optional: a URL that receives a JSON POST for every paid pre-order (Slack incoming webhook, Zapier, Make, your own API)
PREORDER_NOTIFY_URL=
# Local dev server port
PORT=3000
